[global]
    font = monospace 10
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    width = (240, 380)
    height = (20, 160)
    origin = top-right
    offset = 16x38
    notification_limit = 4
    corner_radius = 0
    frame_width = 2
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    icon_position = left
    min_icon_size = 0
    max_icon_size = 32
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 140
    progress_bar_max_width = 280
    progress_bar_corner_radius = 0
    frame_color = "#343f44"
    separator_color = frame

[urgency_low]
    background = "#232a2e"
    foreground = "#859289"
    frame_color = "#343f44"
    timeout = 4

[urgency_normal]
    background = "#232a2e"
    foreground = "#d3c6aa"
    frame_color = "#a7c080"
    timeout = 6

[urgency_critical]
    background = "#232a2e"
    foreground = "#e67e80"
    frame_color = "#e67e80"
    timeout = 0
